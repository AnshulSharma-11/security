# Isolated scanner worker: the only image that ships nmap + nuclei.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG NUCLEI_VERSION=3.3.7
RUN apt-get update && apt-get install -y --no-install-recommends nmap curl unzip ca-certificates \
 && A=$(dpkg --print-architecture) && curl -fsSL -o /tmp/n.zip \
    "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${A}.zip" \
 && unzip /tmp/n.zip nuclei -d /usr/local/bin && rm /tmp/n.zip && apt-get purge -y curl unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd -m -u 10001 sentinel
COPY app ./app
USER sentinel
RUN nuclei -update-templates -silent || true
CMD ["celery", "-A", "app.tasks", "worker", "--loglevel=info", "--concurrency=2"]
